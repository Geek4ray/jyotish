# Copy to .env beside docker-compose.yml and fill in. Never commit .env.
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=
# Each role's model (docs/models.md): leave empty for Anthropic, or an OpenAI-compatible backend, e.g. on DeepInfra
# JYOTISH_CHECKER_BACKEND=openai:https://api.deepinfra.com/v1/openai:zai-org/GLM-4.7 with its key in JYOTISH_OPENAI_KEY.
JYOTISH_WRITER_BACKEND=
JYOTISH_CHECKER_BACKEND=
JYOTISH_CLIENT_BACKEND=
JYOTISH_OPENAI_KEY=
# The fast writers (docs/models.md): each provider is sent its own key only, never the one above.
JYOTISH_CEREBRAS_KEY=
JYOTISH_GROQ_KEY=
# Where the source is offered (Swiss Ephemeris is AGPL-3.0: docs/deploy.md), e.g. the GitHub repository.
JYOTISH_SOURCE_URL=
# For `docker compose --profile host` (Caddy and the nightly backup): the domain whose A record points here.
JYOTISH_DOMAIN=
RETENTION_DAYS=14
